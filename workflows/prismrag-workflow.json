{
  "name": "PrismRAG — Drive ingestion and Telegram document QA",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {"item": [{"mode": "everyMinute"}]},
        "triggerOn": "specificFolder",
        "folderToWatch": {"__rl": true, "value": "YOUR_DRIVE_FOLDER_ID", "mode": "id"},
        "event": "fileCreated",
        "options": {}
      },
      "id": "drive-trigger",
      "name": "Google Drive — New PDF",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [-1080, -260],
      "credentials": {"googleDriveOAuth2Api": {"id": "YOUR_GOOGLE_CREDENTIAL_ID", "name": "Google Drive account"}}
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {"__rl": true, "value": "={{ $json.id }}", "mode": "id"},
        "options": {"binaryPropertyName": "data"}
      },
      "id": "drive-download",
      "name": "Download document",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [-840, -260],
      "credentials": {"googleDriveOAuth2Api": {"id": "YOUR_GOOGLE_CREDENTIAL_ID", "name": "Google Drive account"}}
    },
    {
      "parameters": {
        "mode": "insert",
        "pineconeIndex": {"__rl": true, "value": "prismrag-knowledge", "mode": "list", "cachedResultName": "prismrag-knowledge"},
        "options": {"pineconeNamespace": "workspace"}
      },
      "id": "pinecone-ingest",
      "name": "Embed + index in Pinecone",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [-560, -260],
      "credentials": {"pineconeApi": {"id": "YOUR_PINECONE_CREDENTIAL_ID", "name": "Pinecone account"}}
    },
    {
      "parameters": {
        "dataType": "binary",
        "binaryMode": "specificField",
        "loader": "pdfLoader",
        "options": {"metadata": {"metadataValues": [{"name": "source", "value": "={{ $('Google Drive — New PDF').item.json.name }}"}, {"name": "driveFileId", "value": "={{ $('Google Drive — New PDF').item.json.id }}"}]}}
      },
      "id": "document-loader",
      "name": "PDF data loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [-620, -40]
    },
    {
      "parameters": {"chunkSize": 720, "chunkOverlap": 110, "options": {}},
      "id": "text-splitter",
      "name": "Recursive text splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [-760, 160]
    },
    {
      "parameters": {"modelName": "models/text-embedding-004"},
      "id": "ingest-embeddings",
      "name": "Document embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [-440, -40],
      "credentials": {"googlePalmApi": {"id": "YOUR_GEMINI_CREDENTIAL_ID", "name": "Google Gemini API"}}
    },
    {
      "parameters": {"updates": ["message"], "additionalFields": {}},
      "id": "telegram-trigger",
      "name": "Telegram — Ask a question",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [-1080, 520],
      "webhookId": "replace-with-n8n-webhook-id",
      "credentials": {"telegramApi": {"id": "YOUR_TELEGRAM_CREDENTIAL_ID", "name": "PrismRAG Telegram bot"}}
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {"systemMessage": "You are PrismRAG. Answer only from the Pinecone document search tool. Include source names in the answer. If the retrieved context is insufficient, say that the knowledge base does not contain the answer."}
      },
      "id": "rag-agent",
      "name": "Grounded QA agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2.2,
      "position": [-720, 520]
    },
    {
      "parameters": {"model": {"__rl": true, "value": "llama-3.3-70b-versatile", "mode": "list", "cachedResultName": "llama-3.3-70b-versatile"}, "options": {"temperature": 0.1}},
      "id": "groq-model",
      "name": "Groq chat model",
      "type": "@n8n/n8n-nodes-langchain.lmChatGroq",
      "typeVersion": 1,
      "position": [-840, 760],
      "credentials": {"groqApi": {"id": "YOUR_GROQ_CREDENTIAL_ID", "name": "Groq account"}}
    },
    {
      "parameters": {
        "mode": "retrieve-as-tool",
        "toolName": "search_company_documents",
        "toolDescription": "Search the indexed Google Drive documents for evidence relevant to the user's question.",
        "pineconeIndex": {"__rl": true, "value": "prismrag-knowledge", "mode": "list", "cachedResultName": "prismrag-knowledge"},
        "topK": 4,
        "options": {"pineconeNamespace": "workspace"}
      },
      "id": "pinecone-search",
      "name": "Pinecone knowledge search",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePinecone",
      "typeVersion": 1.3,
      "position": [-560, 760],
      "credentials": {"pineconeApi": {"id": "YOUR_PINECONE_CREDENTIAL_ID", "name": "Pinecone account"}}
    },
    {
      "parameters": {"modelName": "models/text-embedding-004"},
      "id": "query-embeddings",
      "name": "Query embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsGoogleGemini",
      "typeVersion": 1,
      "position": [-440, 960],
      "credentials": {"googlePalmApi": {"id": "YOUR_GEMINI_CREDENTIAL_ID", "name": "Google Gemini API"}}
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram — Ask a question').item.json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {"appendAttribution": false, "parse_mode": "Markdown"}
      },
      "id": "telegram-reply",
      "name": "Send grounded answer",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [-360, 520],
      "credentials": {"telegramApi": {"id": "YOUR_TELEGRAM_CREDENTIAL_ID", "name": "PrismRAG Telegram bot"}}
    },
    {
      "parameters": {"content": "## Automatic document ingestion\nNew PDFs in Google Drive are downloaded, chunked, embedded, and upserted into the workspace namespace in Pinecone.", "height": 180, "width": 700, "color": 5},
      "id": "ingestion-note",
      "name": "Ingestion note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1130, -420]
    },
    {
      "parameters": {"content": "## Telegram document QA\nQuestions are routed to a tool-using Groq agent. Pinecone supplies the evidence and Telegram returns a document-grounded answer.", "height": 190, "width": 820, "color": 6},
      "id": "qa-note",
      "name": "QA note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-1130, 360]
    }
  ],
  "pinData": {},
  "connections": {
    "Google Drive — New PDF": {"main": [[{"node": "Download document", "type": "main", "index": 0}]]},
    "Download document": {"main": [[{"node": "Embed + index in Pinecone", "type": "main", "index": 0}]]},
    "PDF data loader": {"ai_document": [[{"node": "Embed + index in Pinecone", "type": "ai_document", "index": 0}]]},
    "Recursive text splitter": {"ai_textSplitter": [[{"node": "PDF data loader", "type": "ai_textSplitter", "index": 0}]]},
    "Document embeddings": {"ai_embedding": [[{"node": "Embed + index in Pinecone", "type": "ai_embedding", "index": 0}]]},
    "Telegram — Ask a question": {"main": [[{"node": "Grounded QA agent", "type": "main", "index": 0}]]},
    "Grounded QA agent": {"main": [[{"node": "Send grounded answer", "type": "main", "index": 0}]]},
    "Groq chat model": {"ai_languageModel": [[{"node": "Grounded QA agent", "type": "ai_languageModel", "index": 0}]]},
    "Pinecone knowledge search": {"ai_tool": [[{"node": "Grounded QA agent", "type": "ai_tool", "index": 0}]]},
    "Query embeddings": {"ai_embedding": [[{"node": "Pinecone knowledge search", "type": "ai_embedding", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
