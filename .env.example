# Local application
DATABASE_NAME=prismrag.sqlite3
MAX_FILE_SIZE_MB=12
CHUNK_SIZE=720
CHUNK_OVERLAP=110

# Pinecone integrated embeddings (optional)
USE_PINECONE=false
PINECONE_API_KEY=
PINECONE_INDEX=prismrag-knowledge
PINECONE_NAMESPACE=workspace
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# LLM synthesis (optional; local grounded synthesis is the default)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Automation channels
TELEGRAM_BOT_TOKEN=
N8N_WEBHOOK_SECRET=replace-this-secret
